<%- include('../../partials/header') %>

<div class="admin-container">
    <div class="admin-header">
        <h1><%= title %></h1>
        <a href="/admin/seasons" class="btn btn-secondary">← Back to List</a>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
        <h3>⚠️ Please fix the following errors:</h3>
        <ul>
            <% errors.forEach(error => { %>
            <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
    <% } %>

    <form method="POST" action="<%= season ? `/admin/seasons/${season.id}?_method=PUT` : '/admin/seasons' %>" class="admin-form">
        <div class="form-group">
            <label for="seasonId">Season ID: <span class="required">*</span></label>
            <input type="text" id="seasonId" name="seasonId" value="<%= season ? season.seasonId : '' %>" required>
            <small>Unique identifier (e.g., "1", "2", "michonne")</small>
        </div>

        <div class="form-group">
            <label for="title">Title: <span class="required">*</span></label>
            <input type="text" id="title" name="title" value="<%= season ? season.title : '' %>" required minlength="3">
            <small>Minimum 3 characters</small>
        </div>

        <div class="form-group">
            <label for="description">Description: <span class="required">*</span></label>
            <textarea id="description" name="description" rows="4" required minlength="10"><%= season ? season.description : '' %></textarea>
            <small>Minimum 10 characters</small>
        </div>

        <div class="form-group">
            <label for="image">Image URL: <span class="required">*</span></label>
            <input type="text" id="image" name="image" value="<%= season ? season.image : '' %>" required>
            <small>e.g., /images/seasonOne.jpg</small>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="releaseDate">Release Date: <span class="required">*</span></label>
                <input type="date" id="releaseDate" name="releaseDate" value="<%= season ? season.releaseDate : '' %>" required>
            </div>

            <div class="form-group">
                <label for="rating">Rating: <span class="required">*</span></label>
                <input type="number" id="rating" name="rating" min="0" max="10" step="0.1" value="<%= season ? season.rating : '' %>" required>
                <small>Between 0 and 10</small>
            </div>

            <div class="form-group">
                <label for="status">Status: <span class="required">*</span></label>
                <select id="status" name="status" required>
                    <option value="completed" <%= season && season.status === 'completed' ? 'selected' : '' %>>Completed</option>
                    <option value="ongoing" <%= season && season.status === 'ongoing' ? 'selected' : '' %>>Ongoing</option>
                    <option value="upcoming" <%= season && season.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 <%= season ? 'Update' : 'Create' %> Season</button>
            <a href="/admin/seasons" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>