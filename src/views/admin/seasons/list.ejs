<%- include('../../partials/header') %>

<div class="admin-container">
    <div class="admin-header">
        <h1><%= title %></h1>
        <div class="admin-actions">
            <a href="/admin/seasons/new" class="btn btn-primary">➕ Add New Season</a>
            <a href="/" class="btn btn-secondary">🏠 Back to Home</a>
        </div>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Release Date</th>
                    <th>Rating</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% seasons.forEach(season => { %>
                <tr>
                    <td><%= season.id %></td>
                    <td><%= season.title %></td>
                    <td><%= season.releaseDate %></td>
                    <td>⭐ <%= season.rating %></td>
                    <td><span class="status-badge status-<%= season.status %>"><%= season.status %></span></td>
                    <td class="action-buttons">
                        <a href="/season/<%= season.seasonId %>" class="btn btn-small btn-info">👁️ View</a>
                        <a href="/admin/seasons/<%= season.id %>/edit" class="btn btn-small btn-warning">✏️ Edit</a>
                        <a href="/admin/seasons/<%= season.seasonId %>/episodes" class="btn btn-small btn-success">📺 Episodes</a>
                        <form method="POST" action="/admin/seasons/<%= season.id %>?_method=DELETE" style="display: inline;">
                            <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Are you sure you want to delete this season?')">🗑️ Delete</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>