<%- include('../../partials/header') %>

<div class="admin-container">
    <div class="admin-header">
        <h1><%= title %></h1>
        <a href="/admin/seasons/<%= season.seasonId %>/episodes" class="btn btn-secondary">← Back to Episodes</a>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
        <h3>⚠️ Please fix the following errors:</h3>
        <ul>
            <% errors.forEach(error => { %>
            <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
    <% } %>

    <form method="POST" action="<%= episode ? `/admin/seasons/${season.seasonId}/episodes/${episode.id}?_method=PUT` : `/admin/seasons/${season.seasonId}/episodes` %>" class="admin-form">
        <div class="form-group">
            <label for="episodeNumber">Episode Number: <span class="required">*</span></label>
            <input type="number" id="episodeNumber" name="episodeNumber" value="<%= episode ? episode.episodeNumber : '' %>" required min="1">
        </div>

        <div class="form-group">
            <label for="title">Title: <span class="required">*</span></label>
            <input type="text" id="title" name="title" value="<%= episode ? episode.title : '' %>" required minlength="3">
            <small>Minimum 3 characters</small>
        </div>

        <div class="form-group">
            <label for="description">Description: <span class="required">*</span></label>
            <textarea id="description" name="description" rows="4" required minlength="10"><%= episode ? episode.description : '' %></textarea>
            <small>Minimum 10 characters</small>
        </div>

        <div class="form-group">
            <label for="duration">Duration (minutes): <span class="required">*</span></label>
            <input type="number" id="duration" name="duration" value="<%= episode ? episode.duration : '' %>" required min="1">
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 <%= episode ? 'Update' : 'Create' %> Episode</button>
            <a href="/admin/seasons/<%= season.seasonId %>/episodes" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>