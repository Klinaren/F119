<%- include('../../partials/header') %>

<div class="admin-container">
    <div class="admin-header">
        <h1><%= title %></h1>
        <div class="admin-actions">
            <a href="/admin/seasons/<%= season.seasonId %>/episodes/new" class="btn btn-primary">➕ Add New Episode</a>
            <a href="/admin/seasons" class="btn btn-secondary">← Back to Seasons</a>
        </div>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Episode #</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (episodes && episodes.length > 0) { %>
                    <% episodes.forEach(episode => { %>
                    <tr>
                        <td><%= episode.episodeNumber %></td>
                        <td><%= episode.title %></td>
                        <td><%= episode.description.substring(0, 50) %>...</td>
                        <td><%= episode.duration %> min</td>
                        <td class="action-buttons">
                            <a href="/admin/seasons/<%= season.seasonId %>/episodes/<%= episode.id %>/edit" class="btn btn-small btn-warning">✏️ Edit</a>
                            <form method="POST" action="/admin/seasons/<%= season.seasonId %>/episodes/<%= episode.id %>?_method=DELETE" style="display: inline;">
                                <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Are you sure?')">🗑️ Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="text-align: center;">No episodes yet</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>